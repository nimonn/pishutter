[Unit]
Description=PiShutter Kiosk Touch Display
After=network.target pishutter.service
Wants=pishutter.service

[Service]
User=pi
Group=pi
SupplementaryGroups=video input tty render
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
PAMName=login
Environment=DISPLAY=:0
ExecStart=/usr/bin/xinit /home/pi/pishutter/start-kiosk.sh -- :0 vt7 -nocursor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
